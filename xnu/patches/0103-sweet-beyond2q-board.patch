diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 2d8d587..c526006 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -528,10 +528,16 @@ int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
 	/* Board-specific helper: only the board's touch rail, sane voltage. */
+#ifdef SWEET_DEV_TOUCH_VREG_NAME
 	if (!res || strcmp(res, SWEET_DEV_TOUCH_VREG_NAME) || mv < 2950 || mv > 3400) {
 		printf("SWEET RPMH: expected %s and 2950..3400 mV\n", SWEET_DEV_TOUCH_VREG_NAME);
 		return EINVAL;
 	}
+#else
+	/* This board names no RPMh rail for touch: refuse every request. */
+	printf("SWEET RPMH: no vreg on this board, refusing %s %u mV\n", res ? res : "?", mv);
+	return EINVAL;
+#endif
 	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
 		return EBUSY;
 	}
