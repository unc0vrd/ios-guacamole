+#define SWEET_DEV_TOUCH_NO_TLMM_PROBE 0
+#endif
+#define TS_PIN_RESET    SWEET_DEV_TOUCH_PIN_RESET
+#define TS_PIN_1V8      SWEET_DEV_TOUCH_PIN_1V8
+#define TS_PIN_IRQ      SWEET_DEV_TOUCH_PIN_IRQ
