+	printf("SWEET TOUCH: no reset pin, SW_RESET -> %d\n", ts_cmd(TS_CMD_SW_RESET));
+	ts_wait(140);
+#endif
 	printf("SWEET TOUCH: pins now rst=%#x/%#x 1v8=%#x/%#x irq=%#x/%#x bus=%#x/%#x\n",
