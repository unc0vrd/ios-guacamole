diff --git a/pexpert/pexpert/arm64/sweet_dev.h b/pexpert/pexpert/arm64/sweet_dev.h
index 0b7870b..8466b5c 100644
--- a/pexpert/pexpert/arm64/sweet_dev.h
+++ b/pexpert/pexpert/arm64/sweet_dev.h
@@ -119,6 +119,60 @@
 #define SWEET_DEV_PANEL_MM_W    76
 #define SWEET_DEV_PANEL_MM_H    163
 
+#if defined(ARM64_BOARD_CONFIG_BEYOND2Q)
+/* ------------- Samsung Galaxy S10+ (beyond2q, SM-G9750) -------------
+ * Same SM8150 as guacamole, so every SoC block above (SPMI, RPMh, USB, GCC,
+ * TLMM, the touch serial engine) applies as is. Only the board facts below
+ * differ. Source: the stock boot.img base DTB (SM8150 v2) and dtbo entry 1
+ * ("BEYOND2Q PROJECT Rev16", board-id 0x10, the one sboot picks). */
+#undef SWEET_DEV_NAME
+#define SWEET_DEV_NAME          "beyond2q"
+
+/* cont_splash_region 0x9C400000 + 0x02000000 (32 MiB); S6E3HA9 AMB644WF01,
+ * 1440x3040, DSC command mode on dual DSI. sboot leaves the command-mode
+ * datapath idle after its splash frame (unlike OnePlus ABL), so the panel
+ * only shows this buffer once scanout is restarted. */
+#undef SWEET_DEV_FB_PA
+#define SWEET_DEV_FB_PA         0x9c400000UL
+#undef SWEET_DEV_FB_H
+#define SWEET_DEV_FB_H          3040
+
+/* Keys: volume up = PM8150L (SID 4) GPIO12, RT_STS 0xcb10, active low;
+ * volume down = PM8150 PON RESIN (qcom,pon_2), as on sweet. Bixby is
+ * PM8150L GPIO8 and is not wired up. */
+#undef SWEET_DEV_VOL_GPIO_RT
+#define SWEET_DEV_VOL_GPIO_RT   0xcb10u
+#undef SWEET_DEV_VOL_GPIO_SID
+#define SWEET_DEV_VOL_GPIO_SID  4
+#undef SWEET_DEV_VOL_DOWN_PON
+#define SWEET_DEV_VOL_DOWN_PON  1
+
+/* Touch: sec_ts (firmware y771) @0x48 on SE17, SDA/SCL tlmm 55/56 as on
+ * guacamole, IRQ tlmm 87. This board has no touch reset or 1.8 V switch pin;
+ * dvdd/avdd are S2DOS05 LDO2/LDO3 with regulator_boot_on, so sboot leaves
+ * them on. Never vote ldoa17 or drive guacamole's tlmm 54/119/104 here:
+ * those belong to other parts of this board. 0xffff = no such pin. */
+#define SWEET_DEV_TOUCH_PIN_IRQ        87u
+#define SWEET_DEV_TOUCH_PIN_RESET      0xffffu
+#define SWEET_DEV_TOUCH_PIN_1V8        0xffffu
