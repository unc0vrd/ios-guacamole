+/* Touch pins (live device tree: tp_1v8/tp_rst/tp_irq). Defaults are
+ * guacamole's; a board overrides them in sweet_dev.h. TS_PIN_NONE = the
+ * board has no such pin: never passed to the TLMM accessors, whose
+ * pin * 0x1000 offset would land outside the mapped tile. */
+#define TS_PIN_NONE     0xffffu
+#ifndef SWEET_DEV_TOUCH_PIN_RESET
+#define SWEET_DEV_TOUCH_PIN_RESET 54u
+#endif
+#ifndef SWEET_DEV_TOUCH_PIN_1V8
+#define SWEET_DEV_TOUCH_PIN_1V8   119u
