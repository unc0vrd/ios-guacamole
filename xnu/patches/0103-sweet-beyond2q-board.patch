+	    ts_pin_cfg(TS_PIN_RESET), ts_pin_io(TS_PIN_RESET),
+	    ts_pin_cfg(TS_PIN_1V8), ts_pin_io(TS_PIN_1V8),
 	    ts_gpio_rd(TS_PIN_IRQ), ts_gpio_io_rd(TS_PIN_IRQ),
 	    ts_gpio_io_rd(TS_PIN_I2C_A), ts_gpio_io_rd(TS_PIN_I2C_B));
 
@@ -548,6 +595,11 @@ ts_thread(void *arg __unused, wait_result_t wr __unused)
 		ts.scl_pin = t;
 		bb_level(TS_PIN_I2C_A, false);
 		bb_level(TS_PIN_I2C_B, false);
+#if TS_PIN_RESET == TS_PIN_NONE
+		/* The first SW_RESET went out on the wrong lines; repeat it. */
+		printf("SWEET TOUCH: SW_RESET (swapped) -> %d\n", ts_cmd(TS_CMD_SW_RESET));
+		ts_wait(140);
+#endif
 		ts.ack_err = ts_wait_ready(TS_ACK_BOOT_COMPLETE, 50);
 	}
 	printf("SWEET TOUCH: boot-complete ack -> %d (sda=%u scl=%u)\n",
