 #define TS_PIN_I2C_A    55u
 #define TS_PIN_I2C_B    56u
@@ -145,6 +162,19 @@ ts_gpio_io_rd(unsigned pin)
 	return ts_rd(ts_tiles[ts_tile(pin)], TS_GPIO_IO_OFF(pin));
 }
 
+/* Report helpers: 0 for a pin this board does not have. */
+static uint32_t
+ts_pin_cfg(unsigned pin)
+{
+	return pin == TS_PIN_NONE ? 0 : ts_gpio_rd(pin);
+}
+
+static uint32_t
+ts_pin_io(unsigned pin)
+{
+	return pin == TS_PIN_NONE ? 0 : ts_gpio_io_rd(pin);
+}
+
 static void
 ts_gpio_wr(unsigned pin, uint32_t v)
 {
@@ -508,33 +538,50 @@ ts_thread(void *arg __unused, wait_result_t wr __unused)
 	ts.scl_pin = TS_PIN_I2C_B;
 
 	printf("SWEET TOUCH: pins reset=%#x/%#x 1v8=%#x/%#x irq=%#x/%#x\n",
